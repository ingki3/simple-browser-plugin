{
  "name": "simple-browser-plugin",
  "version": "0.2.34",
  "private": true,
  "description": "사이드 패널에서 말로 시키는 Chrome 브라우저 도우미 (OpenRouter·OpenAI·Gemini·Claude)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "harness": "node tests/harness/run.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "vendor:kordoc": "npm --prefix vendor/kordoc ci --ignore-scripts && npm --prefix vendor/kordoc run build"
  },
  "dependencies": {
    "docling.rs-wasm": "2.15.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tldts": "7.4.16",
    "tweetnacl": "1.0.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.27",
    "@types/chrome": "^0.0.279",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "1.64.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}

{
  "permissions": {
    "allow": [
      "Bash(.claude/scripts/codex-review.sh)",
      "Bash(.claude/scripts/codex-review.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-codex-review.py"
          }
        ]
      }
    ]
  }
}
